name: Extract POKEWAY SURF ZIP

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract game ZIP
        run: |
          ZIP=$(find . -iname 'POKEWAY_SURF_GITHUB_STARTER.zip' | head -n 1)

          if [ -z "$ZIP" ]; then
            echo "ZIP file not found!"
            exit 1
          fi

          mkdir -p /tmp/pokeway
          unzip -q "$ZIP" -d /tmp/pokeway

          GAME_DIR=$(find /tmp/pokeway -name index.html -printf '%h\n' | head -n 1)

          if [ -z "$GAME_DIR" ]; then
            echo "Game files not found!"
            exit 1
          fi

          cp -a "$GAME_DIR"/. .

      - name: Save extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract POKEWAY SURF files" || echo "Nothing to commit"
          git push
